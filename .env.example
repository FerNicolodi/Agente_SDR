# Copie para .env e preencha com valores reais antes de rodar localmente ou
# de empacotar para o Portal de Deploy DB1 (app.db1group.com).
#
# IMPORTANTE (Especificação Técnica, seção 10.3): o .env NUNCA deve ser
# commitado no GitHub (já está no .gitignore). No Portal de Deploy, hoje, ele
# só é enviado dentro do .zip no momento do upload — trate esse arquivo como
# segredo mesmo fora do Git.

# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WA_VERIFY_TOKEN=
META_WA_M1_TEMPLATE_NAME=abertura_qualificacao_v1

# HubSpot
HUBSPOT_API_KEY=

# Slack (notificação ao Closer)
SLACK_BOT_TOKEN=
SLACK_CLOSER_CHANNEL=

# Anthropic (extrator de sinal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Webhook do formulário do site
SITE_FORM_HMAC_SECRET=

# Callback de timers via HubSpot Workflow
HUBSPOT_WORKFLOW_HMAC_SECRET=
