# =============================================================================
# Agente SDR DGS — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA deve ser commitado no GitHub (já está no .gitignore).
#
# Para testes locais sem integrações reais, use os valores "fake_*" abaixo —
# o servidor sobe e o fluxo de decisão funciona; só as chamadas externas
# (HubSpot, Slack, Meta, SMTP) vão logar erro e seguir em frente.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM (obrigatório mesmo em teste local)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Modelo padrão já definido no código; só altere se quiser usar outro.
# ANTHROPIC_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# Z-API — canal WhatsApp (z-api.io, SaaS gerenciado)
#
# ZAPI_INSTANCE_ID    ID da instância no painel Z-API
#                     Encontrado em: painel Z-API → sua instância → Instance ID
# ZAPI_TOKEN          Token da instância no painel Z-API
#                     Encontrado em: painel Z-API → sua instância → Token
# ZAPI_CLIENT_TOKEN   Security Token configurado no painel Z-API
#                     Configurar em: painel → sua instância → Security Token
#                     (esse token é enviado pelo Z-API no header `client-token`
#                      de cada webhook — usado para autenticar as requisições)
#
# Webhook a configurar no painel Z-API:
#   URL: https://<seu-app>.apps.db1group.com/webhook/whatsapp
#   Tipo: On Message Received
#   Security Token: mesmo valor de ZAPI_CLIENT_TOKEN abaixo
# -----------------------------------------------------------------------------
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID_AQUI
ZAPI_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=troque_por_security_token_zapi


# -----------------------------------------------------------------------------
# Storage backend — controla onde o estado do lead é persistido
#   hubspot → produção real (padrão; requer HUBSPOT_API_KEY válida com as 20
#             propriedades customizadas criadas — ver scripts/hubspot_setup.py
#             e HUBSPOT_SETUP.md)
#   memory  → dict Python em memória (SÓ para teste local — dados somem a
#             cada restart e NADA é gravado no HubSpot). Exige também
#             MEMORY_STORAGE_ACK=true abaixo, ou o servidor recusa subir.
# -----------------------------------------------------------------------------
# STORAGE_BACKEND=hubspot
# MEMORY_STORAGE_ACK=true


# -----------------------------------------------------------------------------
# HubSpot
# Obtido em: app.hubspot.com → Configurações → Integrações → Aplicativos privados
# (precisa ser um Private App token — pat-na-... — não a chave de API legada)
# -----------------------------------------------------------------------------
HUBSPOT_API_KEY=fake_hubspot_key


# -----------------------------------------------------------------------------
# Slack
# Obtido em: api.slack.com → seu app → OAuth & Permissions → Bot Token (xoxb-)
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=fake_slack_token
SLACK_CLOSER_CHANNEL=closer-alerts


# -----------------------------------------------------------------------------
# Segurança — HMAC para webhooks
# Escolha strings aleatórias longas (ex: openssl rand -hex 32)
# -----------------------------------------------------------------------------
SITE_FORM_HMAC_SECRET=troque_por_string_aleatoria_longa
HUBSPOT_WORKFLOW_HMAC_SECRET=troque_por_outra_string_aleatoria


# -----------------------------------------------------------------------------
# Rate limiting (opcional — padrão: 60 segundos)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_SECONDS=60


# -----------------------------------------------------------------------------
# SMTP — notificações por e-mail (opcional; fluxo funciona sem isso)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@email.com
# SMTP_PASSWORD=senha_de_app
# SMTP_FROM=seu@email.com
# NOTIFICATION_EMAIL_TO=closer@db1.com.br
